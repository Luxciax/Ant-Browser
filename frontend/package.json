{
  "name": "ant-browser-frontend",
  "private": true,
  "version": "1.9.5",
  "type": "module",
  "scripts": {
    "ensure:native": "node ./scripts/ensure-rollup-native.mjs",
    "postinstall": "npm run ensure:native",
    "dev": "node ./scripts/dev-watcher.mjs",
    "dev:raw": "npm run ensure:native && node --max-old-space-size=256 --max-semi-space-size=16 ./node_modules/vite/bin/vite.js",
    "build": "npm run build:keep",
    "build:keep": "npm run ensure:native && node --max-old-space-size=1024 ./node_modules/typescript/bin/tsc && node --max-old-space-size=1024 ./node_modules/vite/bin/vite.js build",
    "build:clean": "cross-env FRONTEND_CLEAN_DIST=1 npm run build:keep",
    "preview": "npm run ensure:native && node --max-old-space-size=256 --max-semi-space-size=16 ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "clsx": "^2.0.0",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "7.18.6",
    "recharts": "^2.10.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "10.7.0",
    "cross-env": "^10.1.0",
    "postcss": "8.5.33",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "lodash": "4.18.1",
    "mdast-util-to-hast": "13.2.2",
    "tailwindcss": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.9"
      },
      "picomatch": "2.3.2",
      "postcss-selector-parser": "6.1.5"
    }
  }
}
